# T026 — Variables de entorno requeridas para front-app
# Copiar este archivo a .env.local y completar los valores

# URL base del backend de CitasIA (FastAPI)
VITE_API_URL=http://localhost:8000

# Supabase — obtener en https://supabase.com/dashboard/project/<id>/settings/api
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<tu-anon-key>
