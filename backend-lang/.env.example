# Variables de entorno del backend (plantilla, sin valores reales)
# Copia este archivo a backend-lang/.env y rellena los valores.
# backend-lang/.env NUNCA se commitea (está en .gitignore).

# ── Kapso (WhatsApp Business API) ──────────────────────────────────────────
# Interruptor general. Con false, las rutas de Kapso responden 404 y no se llama a Kapso.
KAPSO_ENABLED=false
# API key del proyecto Kapso (header X-API-Key). Rotar la clave antes de usarla.
KAPSO_API_KEY=
# Base de la API de Kapso (por defecto https://api.kapso.ai).
KAPSO_BASE_URL=https://api.kapso.ai
# Secreto del webhook de PROYECTO (eventos como whatsapp.phone_number.created).
# Obligatorio si KAPSO_ENABLED=true.
KAPSO_WEBHOOK_SECRET_PROJECT=
# Secreto del webhook de NÚMERO (mensajes, whatsapp.message.received).
# Obligatorio si KAPSO_ENABLED=true.
KAPSO_WEBHOOK_SECRET_NUMBER=
# Clave Fernet (base64 urlsafe de 32 bytes). Obligatorio si KAPSO_ENABLED=true.
KAPSO_SECRETS_KEY=
# Compatibilidad: se acepta si está definido, pero ya no basta para activar Kapso.
KAPSO_WEBHOOK_SECRET=

# ── Facebook Login (crear cuenta / entrar) ─────────────────────────────────
# Usa la misma app de Meta del Embedded Signup (META_APP_ID + WHATSAPP_APP_SECRET).
# Debe estar en «URI de redireccionamiento de OAuth válidos» del producto Facebook Login.
FACEBOOK_REDIRECT_URI=https://zumit.app/auth/facebook/callback

# -- LangSmith: costo real de la IA por barberia en Zumit Manager (Costos) --
# Sin clave, los costos son una estimacion por tokens. El agente ya manda workspace_id a cada traza.
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=

# -- Resend: correo de las cuentas de cobro y avisos de facturacion --
RESEND_API_KEY=

# Obligatorias (sin valor por defecto: el backend no arranca si faltan)
FRONTEND_URL=https://zumit.app
RESEND_FROM_EMAIL=Zumit <noreply@tu-dominio.com>
