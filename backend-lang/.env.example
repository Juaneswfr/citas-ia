# Variables de entorno del backend (plantilla, sin valores reales)
# Copia este archivo a backend-lang/.env y rellena los valores.
# backend-lang/.env NUNCA se commitea (está en .gitignore).

# ── Kapso (WhatsApp Business API) ──────────────────────────────────────────
# Interruptor general. Con false, las rutas de Kapso responden 404 y no se llama a Kapso.
KAPSO_ENABLED=false
# API key del proyecto Kapso (header X-API-Key). Rotar la clave antes de usarla.
KAPSO_API_KEY=
# Base de la API de Kapso (por defecto https://api.kapso.ai).
KAPSO_BASE_URL=https://api.kapso.ai
# Secreto del webhook de PROYECTO (eventos como whatsapp.phone_number.created).
# Obligatorio si KAPSO_ENABLED=true.
KAPSO_WEBHOOK_SECRET_PROJECT=
# Secreto del webhook de NÚMERO (mensajes, whatsapp.message.received).
# Obligatorio si KAPSO_ENABLED=true.
KAPSO_WEBHOOK_SECRET_NUMBER=
# Compatibilidad: se acepta si está definido, pero ya no basta para activar Kapso.
KAPSO_WEBHOOK_SECRET=
